require("dotenv").config();
const express = require("express");
const cors = require("cors");
const axios = require("axios");

const app = express();
const port = process.env.PORT || 3000;

app.use(cors());
app.use(express.json());

const XAI_API_KEY = process.env.XAI_API_KEY;
if (!XAI_API_KEY) {
  console.error("Missing XAI_API_KEY in .env");
  process.exit(1);
}

app.post("/chat", async (req, res) => {
  try {
    const { message, language } = req.body;
    if (!message || typeof message !== "string") {
      return res.status(400).json({ error: "message is required and must be a string" });
    }

    const endpoint = "https://api.x.ai/v1/chat/completions";

    const systemPrompt = language == "tagalog"
      ? "You are a helpful parish assistant who replies in Tagalog using polite, friendly language."
      : "You are a helpful parish assistant who replies in English using polite, friendly language.";

    const payload = {
      model: "grok-4-1-fast",
      messages: [
        { role: "system", content: systemPrompt },
        { role: "user", content: message },
      ],
      stream: false,
      temperature: 0,
    };

    const response = await axios.post(endpoint, payload, {
      headers: {
        "Content-Type": "application/json",
        Authorization: `Bearer ${XAI_API_KEY}`,
      },
      timeout: 30000,
    });

    const aiReply =
      response.data?.choices?.[0]?.message?.content ??
      response.data?.output?.[0] ??
      "No response from AI";

    res.json({ reply: aiReply });
  } catch (error) {
    const apiError = error.response?.data || error.message;
    console.error("xAI API error:", apiError);

    if (error.response?.status === 403 || (apiError && apiError.error && apiError.error.includes("doesn't have any credits"))) {
      return res.status(402).json({
        error: "xAI account needs credits or license",
        details: apiError,
        help: "Visit https://console.x.ai/team to buy credits or activate your subscription."
      });
    }

    res.status(500).json({
      error: "Failed to get AI response",
      details: apiError,
    });
  }
});

app.listen(port, () => {
  console.log(`Server running on http://localhost:${port}`);
});